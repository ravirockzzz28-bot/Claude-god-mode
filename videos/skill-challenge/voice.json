  "phrases": [
    {
      "scene": "s01",
      "text": "Hey Miftahul. You said the secret isn't the prompt.",
      "start": 0.15,
      "end": 3.059
    },
    {
      "scene": "s02",
      "text": "It's your skill file.",
      "start": 3.35,
      "end": 4.32
    },
    {
      "scene": "s03",
      "text": "So we ran a test.",
      "start": 4.732,
      "end": 5.96
    },
    {
      "scene": "s04",
      "text": "No subscription.",
      "start": 6.405,
      "end": 7.22
    },
    {
      "scene": "s05",
      "text": "No paywall. No secret file.",
      "start": 7.35,
      "end": 9.095
    },
    {
      "scene": "s06",
      "text": "Just Claude, and a free, open-source skill anyone can install.",
      "start": 9.459,
      "end": 12.72
    },
    {
      "scene": "s07",
      "text": "This is what it made.",
      "start": 13.241,
      "end": 14.16
    },
    {
      "scene": "s08",
      "text": "A fifteen-second podcast teaser.",
      "start": 14.477,
      "end": 16.295
    },
    {
      "scene": "s09",
      "text": "Grain, glow, sound.",
      "start": 16.732,
      "end": 18.6
    },
    {
      "scene": "s10",
      "text": "All code. Your videos are great.",
      "start": 18.986,
      "end": 21.48
    },
    {
      "scene": "s11",
      "text": "But the skill isn't magic.",
      "start": 21.677,
      "end": 23.06
    },
    {
      "scene": "s12",
      "text": "It's taste, written down.",
      "start": 23.277,
      "end": 24.68
    },
    {
      "scene": "s13",
      "text": "So here's the challenge.",
      "start": 25.168,
      "end": 26.1
    },
    {
      "scene": "s14",
      "text": "Same brief. Your skill, versus the free one.",
      "start": 26.404,
      "end": 28.88
    },
    {
      "scene": "s15",
